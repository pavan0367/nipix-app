# ==========================================
# Nipix Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Database Configuration (MySQL / TiDB)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=nipix_db
DB_USER=your_db_user_here
DB_PASSWORD=your_database_password_here

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client Application URL
CLIENT_URL=https://nipix-media.vercel.app

# ==========================================
# Real AI LLM Provider Configuration
# Choose ONE provider (gemini, groq, openai, or openrouter)
# ==========================================
AI_PROVIDER=gemini

# Option 1: Google Gemini (Recommended - Free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq (Ultra-Fast - Free at https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here

# Option 3: OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your_openai_api_key_here

# Option 4: OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Gemini model override
GEMINI_MODEL=gemini-3.5-flash-lite

# ==========================================
# Transactional Email Configuration
# ==========================================
# Option A: Brevo REST API (Recommended for Render)
# Generate free API key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=your-verified-brevo-sender@domain.com
EMAIL_FROM_NAME="Nipix AI Scholar"

# Option B: Standard SMTP (Gmail App Password, Brevo SMTP, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=false
# EMAIL_FROM=your-email@gmail.com
