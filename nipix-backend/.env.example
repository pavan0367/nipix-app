# ==========================================
# Nipix Backend Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Database Configuration (MySQL / TiDB)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=nipix_db
DB_USER=root
DB_PASSWORD=your_database_password_here

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Client Application URL
CLIENT_URL=https://nipix-media.vercel.app

# ==========================================
# Real AI LLM Provider Configuration
# Choose ONE provider (gemini, groq, or openai)
# ==========================================
AI_PROVIDER=gemini

# Option 1: Google Gemini (Recommended - Free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq (Ultra-Fast - Free at https://console.groq.com/keys)
# GROQ_API_KEY=your_groq_api_key_here

# Option 3: OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your_openai_api_key_here
