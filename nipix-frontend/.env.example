# Nipix Frontend Environment Variables
REACT_APP_API_URL=https://nipix-app.onrender.com/api
REACT_APP_SOCKET_URL=https://nipix-app.onrender.com
REACT_APP_FRONTEND_URL=https://nipix-media.vercel.app

# Google OAuth 2.0 Web Client ID (Public client identifier for Google Identity Services)
# Configure authorized JavaScript origin: https://nipix-media.vercel.app
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
